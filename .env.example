# Oracle Cloud Infrastructure (OCI) Credentials
OCI_TENANCY_OCID=ocid1.tenancy.oc1..your-tenancy-ocid
OCI_USER_OCID=ocid1.user.oc1..your-user-ocid
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
# Used for local deploy
OCI_PRIVATE_KEY_FILE=/path/to/your/oci_api_key.pem
# Used for actions CD/CD deploy
OCI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----
your-private-key-content-here
-----END RSA PRIVATE KEY-----
OCI_REGION=ap-melbourne-1
# OCI Compartment (usually same as tenancy for personal accounts)
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..your-tenancy-ocid

# SSH Public Key (for instance access)
SSH_PUBLIC_KEY=ssh-ed25519 AAAAC3...your-public-key

# Pulumi Access Token
PULUMI_ACCESS_TOKEN=pul-your-pulumi-access-token
PULUMI_ORG=your-pulumi-org
PULUMI_STACK=your-stack-name
# Use the below value in your Pulumi.yaml file's name field.
PULUMI_PROJECT=your-project-name

# Tailscale (optional - for private networking)
TAILSCALE_TAILNET=your-tailnet.ts.net
TAILSCALE_CLIENT_ID=your-client-id
TAILSCALE_CLIENT_SECRET=tskey-client-your-secret
TAILSCALE_TAG=your-tag
TAILSCALE_HOSTNAME=your-hostname
